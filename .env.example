# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Gmail account used to send contact/booking emails (nodemailer).
GMAIL_USER=
# Gmail App Password (NOT the account password). Generate one at
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Stripe secret key (server-side). Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret. Dashboard > Developers > Webhooks (or `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key, exposed to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
